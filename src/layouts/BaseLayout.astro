---
const { title = 'Ben Kappes | Gospel & Blues Musician', description = 'Gospel and Blues musician. Still chasing the dream, one chord at a time.' } = Astro.props;
import '../styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>

    <!-- Open Graph -->
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://youcancodenet.github.io/artist-demo-site">
    <meta property="og:image" content="https://youcancodenet.github.io/artist-demo-site/images/og-image.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="Ben Kappes | Broken Soul Music">
    <meta property="og:locale" content="en_US">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content="https://youcancodenet.github.io/artist-demo-site/images/og-image.jpg">

    <link rel="shortcut icon" href="/artist-demo-site/favicon.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=Special+Elite&family=Lora:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <title>Ben Kappes | Music</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
