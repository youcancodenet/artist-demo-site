---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Ben Kappes | Broken Soul Music" description="Gospel & Blues musician. Stories of survival, faith, and healing — one chord at a time.">
    <Card
      name="Ben Kappes"
      position="Gospel & Blues Musician"
      aboutMe={`Through the echoes of the blues and the truth of the Gospel, my music tells a story of survival, finding light in the deepest pain, and unwavering faith. I believe that no soul is too far gone and that every note has the power to heal. Still chasing the dream, one chord at a time.`}
      spotify="https://www.spotify.com"
      instagram="https://www.instagram.com"
      bookings="mailto:brokensoulroad@gmail.com"
      profileImage={`${base}images/profile2.webp`}
    />
</BaseLayout>
