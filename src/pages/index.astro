---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";

// This automatically detects your subfolder path (/artist-demo-site/)
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Personal Card Portfolio Astro" description="Meta description.">
    <Card
      name="John Smith"
      position="Web Developer"
      aboutMe={`Hi there! I'm John...`}
      linkedin="https://www.linkedin.com/in/#"
      github="https://github.com/alcarazbrian"
      cvLink={`${base}files/resume-cv.pdf`}
      profileImage={`${base}images/profile2.webp`}
    />
</BaseLayout>

