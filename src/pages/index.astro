---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";

// This automatically detects your subfolder path (/artist-demo-site/)
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Artist Portfolio" description="Gospel and Blues musician bio.">
    <Card
      name="[Your Name]"
      position="Gospel & Blues Musician"
      aboutMe={`Through the echoes of the blues and the truth of the Gospel, my music tells a story of survival, finding light in the deepest pain, and unwavering faith. I believe that no soul is too far gone and that every note has the power to heal. Still chasing the dream, one chord at a time.`}
      linkedin="https://www.linkedin.com/in/#"
      github="https://github.com/alcarazbrian"
      cvLink={`${base}files/resume-cv.pdf`}
      profileImage={`${base}images/profile2.webp`}
    />
</BaseLayout>